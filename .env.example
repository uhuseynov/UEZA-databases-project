# =============================================================================
# Application & Logging
# =============================================================================
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# =============================================================================
# MariaDB Configuration
# =============================================================================
# 127.0.0.1 when the app runs on your machine; inside docker compose the app uses the 'db' service.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
# Must match the user that docker-compose.yml creates (the MariaDB image refuses MARIADB_USER=root).
MARIADB_USER=ueza
MARIADB_PASSWORD=ueza_password
MARIADB_DATABASE=ueza_db
MARIADB_POOL_RECYCLE=3600
MARIADB_POOL_PRE_PING=true

# =============================================================================
# Ingestion & Cache
# =============================================================================
CACHE_DIR=.cache/articles
CACHE_TTL_SECONDS=86400

# =============================================================================
# MediaWiki Client
# =============================================================================
MEDIAWIKI_USER_AGENT=UEZA-Databases-Project/0.1 (academic-project)
MEDIAWIKI_REQUESTS_PER_SECOND=2.0
MEDIAWIKI_MAX_RETRIES=3
MEDIAWIKI_BATCH_SIZE=20
MEDIAWIKI_TIMEOUT=10.0
MEDIAWIKI_MAXLAG=5

# =============================================================================
# Ingestion
# =============================================================================
ARTICLES_CSV_PATH=data/articles.csv
# A: 256 tokens, 32 overlap. B: 512 tokens, 64 overlap. C: one paragraph, at most 512 tokens.
CHUNK_CONFIG=A
# true: each article at its revision on the last_edit date in the CSV, so every
# machine loads the same text. false: the latest revisions (make ingest-latest).
INGESTION_SNAPSHOT=true

# =============================================================================
# Embeddings & Vector Search (MariaDB Native Vector)
# =============================================================================
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
VECTOR_SEARCH_TOP_K=5

# =============================================================================
# LLM / Generation Service
# =============================================================================
# Any OpenAI-compatible endpoint. For a free local model use Ollama:
#   LLM_API_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  LLM_API_KEY=ollama
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# =============================================================================
# RAG & Evaluation
# =============================================================================
# Answer "not found" without calling the LLM when the closest chunk is further than this
# cosine distance (0 = identical, 2 = opposite). 0.42 keeps the context for 97% of the answerable
# ground-truth questions and rejects every off-topic one; recalibrate it with `make eval`.
RAG_MAX_DISTANCE=0.42
GROUND_TRUTH_PATH=data/ground_truth.csv
EVAL_RESULTS_DIR=eval/results
